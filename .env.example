# Production default: leave these unset. The browser calls same-origin `/api`,
# which the public reverse proxy forwards to the separately deployed backend.
# Do not put tokens, credentials, or other secrets in VITE_* variables: Vite
# embeds them in the client bundle.

# Optional public gateway origin, for example https://api.example.com.
# Production localhost values are ignored and fall back to `/api`.
# VITE_MODEL_API_BASE=https://api.example.com

# F3 uses the same gateway. Leave this unset unless it deliberately has a
# different public origin; production localhost values are also ignored.
# VITE_PARALAB_F3_URL=https://api.example.com

# Local development only: create an untracked `.env.local` with this value.
# VITE_MODEL_API_BASE=http://localhost:7860
