# Alamat API F3 Stability Sentinel dari repository paralab-architecture.
# Website tidak menghitung risiko stabilitas sendiri: bila layanan ini mati,
# panel F3 menampilkan abstain, bukan angka pengganti.
VITE_PARALAB_F3_URL=http://127.0.0.1:8000

# Base URL model gateway: F1 evidence, F2 screening, F4 next validation, F5 draft.
# Satu proses gateway melayani F1 sampai F5, jadi nilai ini dan VITE_PARALAB_F3_URL
# harus menunjuk origin yang sama. Bila hanya salah satu diisi, panel F3 akan
# menampilkan abstain "layanan tidak dapat dihubungi" sementara panel lain normal.
VITE_MODEL_API_BASE=http://localhost:7860
